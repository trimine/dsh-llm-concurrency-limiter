{
  "name": "dsh-llm-concurrency-limiter",
  "version": "1.0.0",
  "description": "Provider, model and session concurrency limits with a graphical settings panel for DeepSeek Harness.",
  "repository": { "type": "git", "url": "git+https://github.com/trimine/dsh-llm-concurrency-limiter.git" },
  "homepage": "https://github.com/trimine/dsh-llm-concurrency-limiter#readme",
  "bugs": { "url": "https://github.com/trimine/dsh-llm-concurrency-limiter/issues" },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test host.test.js semaphore.test.js"
  },
  "type": "module",
  "icon": "icon.svg",
  "author": "DeepSeek Harness Community",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "host.test.js",
    "semaphore.test.js",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "llm",
    "concurrency",
    "rate-limit",
    "queue"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": ["react-dom"],
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
